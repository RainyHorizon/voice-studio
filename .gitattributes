* text=auto

# Unix launchers and source files must keep LF when checked out on macOS/Linux.
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Native Windows launchers use CRLF for cmd.exe and PowerShell compatibility.
*.bat text eol=crlf
*.ps1 text eol=crlf
